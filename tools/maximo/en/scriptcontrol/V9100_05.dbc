<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE script SYSTEM "script.dtd">
<script author="ALEXANDRE" scriptname="SCRIPTCONTROL_DEMO" for_demo_only="true">
  <description></description>
  <statements>

    <insert table="SWG_UISCRIPTS" ignore_duplicates="true">
      <insertrow>
        <columnvalue column="DESCRIPTION" string="Add IFrame in a new tab." />
        <columnvalue column="SCRIPTNUM" string="IFRAME4ASSET" />
        <columnvalue column="SCRIPTCONTENT" string="const pageMapping = await this.getComponentsMapping();&#xA;let sectionId = pageMapping[&quot;google_iframe&quot;];&#xA;sectionId = sectionId[&quot;google_iframe-se&quot;].renderId;&#xA;&#xA;const _install = async () =&gt; {&#xA;    let record = await this.getData(&quot;mainrecord&quot;, [&quot;assetnum&quot;, &quot;description&quot;]);&#xA;    const section = document.getElementById(sectionId);&#xA;    let iframe = section.querySelector(&quot;iframe&quot;);&#xA;    if ( iframe == undefined ) {&#xA;        iframe = document.createElement(&quot;iframe&quot;);&#xA;        iframe.style.width = &quot;100%&quot;;&#xA;        iframe.style.height = &quot;650px&quot;;&#xA;        section.appendChild(iframe);    &#xA;    }&#xA;    &#xA;    if ( record == undefined || record.status != &quot;ok&quot;) {&#xA;        iframe.src = 'https://fr.farnell.com/search';    &#xA;    } else {&#xA;        record = record.data[0];&#xA;        iframe.src = `https://fr.farnell.com/search?st=${record.assetnum}+${record.description}`;&#xA;    }&#xA;    &#xA;    return iframe;&#xA;}&#xA;&#xA;let myIFrame = await _install();&#xA;&#xA;this.registerNotificationCallBack( async (ev) =&gt; {&#xA;    const section = document.getElementById(sectionId);&#xA;    if ( ev === &quot;update&quot; || ev === &quot;refresh&quot; ) {&#xA;        myIframe = _install();&#xA;    } &#xA;    section.appendChild(myIFrame);    &#xA;});" />
        <columnvalue column="ACTIVE" boolean="true" />
        <columnvalue column="HASLD" boolean="false" />
        <columnvalue column="TYPE" string="JAVASCRIPT" />
      </insertrow>
      <insertrow>
        <columnvalue column="DESCRIPTION" string="Table organizer CSS" />
        <columnvalue column="SCRIPTNUM" string="TABLE_ORGANIZER_CSS" />
        <columnvalue column="SCRIPTCONTENT" string=".tableOrganizerDialog {&#xA;    border-radius: 5px;&#xA;    border: 2px solid #000077;&#xA;    box-shadow: 2px 2px 12px 5px rgba(0, 0, 0, 0.5);&#xA;}&#xA;&#xA;&#xA;.tableOrganizerDialog::backdrop {&#xA;    backdrop-filter: blur(5px);&#xA;}&#xA;&#xA;.tableOrganizerDialog .transfer {&#xA;    display: flex; &#xA;    gap: 5px;&#xA;    padding: 5px 0px;&#xA;}&#xA;&#xA;.tableOrganizerDialog .transfer select#leftList,&#xA;.tableOrganizerDialog .transfer select#rightList{&#xA;    flex: 1;&#xA;    min-height: 300px;&#xA;    min-width: 200px;&#xA;}&#xA;&#xA;.tableOrganizerDialog .transfer .transfer-buttons {&#xA;    display: flex;&#xA;    flex-direction: column;&#xA;    gap: 5px;&#xA;    justify-content: center;&#xA;}&#xA;&#xA;&#xA;.tableOrganizerDialog .footer {&#xA;    display: flex; &#xA;    justify-content: end; &#xA;    gap: 5px;&#xA;}" />
        <columnvalue column="ACTIVE" boolean="true" />
        <columnvalue column="HASLD" boolean="false" />
        <columnvalue column="TYPE" string="CSS" />
      </insertrow>
      <insertrow>
        <columnvalue column="DESCRIPTION" string="Table organizer" />
        <columnvalue column="SCRIPTNUM" string="TABLE_ORGANIZER" />
        <columnvalue column="SCRIPTCONTENT" string="function TableOrganizer(tableId, scriptControl){&#xA;    this.tableId = tableId;&#xA;    &#xA;    scriptControl.getControlStructure(tableId).then(res =&gt; {&#xA;        const struct = res[tableId];&#xA;    &#xA;        this._tableId = struct.renderId;&#xA;        this._tableOuterId = struct.components[0].children[0].children[0].renderId;&#xA;        &#xA;        this._dataColumns = struct&#xA;            .children[0].children&#xA;            .filter( el =&gt; el.type === &quot;tablecol&quot;)&#xA;            .filter( el =&gt; el.display == undefined || el.display == &quot;true&quot;)&#xA;            .filter( col =&gt; col.components[0]?.properties[&quot;dataattribute&quot;] != undefined);&#xA;        &#xA;        // find the button we would like to clone &#xA;        let clearFilterComponent = struct.components[0]?.children[0]?.children[0]?.children[0]?.children[0]?.children[5];&#xA;        if ( clearFilterComponent === undefined ) {&#xA;            console.error(&quot;Cannot find the place to insert decorator&quot;);&#xA;            return;&#xA;        }&#xA;        clearFilterComponent = document.getElementById(clearFilterComponent.renderId);&#xA;        if ( clearFilterComponent == undefined ) {&#xA;            console.error(&quot;Cannot find rendered clear filter button&quot;);&#xA;            return;&#xA;        }&#xA;        const tdContainingButton = clearFilterComponent.parentNode;&#xA;        const clonedTD = tdContainingButton.cloneNode(false);&#xA;        tdContainingButton.parentNode.insertBefore(clonedTD,tdContainingButton);&#xA;        clonedTD.innerHTML = &quot;&quot;;// &quot;&lt;button&gt;Organize&lt;/button&gt;&quot;;&#xA;        const btn = document.createElement(&quot;button&quot;);&#xA;        btn.innerHTML = &quot;&lt;img src='miniapps/scheduler/ac22_columnsSelector.png' /&gt;&quot;;&#xA;        clonedTD.appendChild(btn);&#xA;        &#xA;        this._filterButton = struct.components[0]?.children[0]?.children[0]?.children[0]?.children[0]?.children[5].renderId&#xA;        this._organizeButton = clonedTD;&#xA;        &#xA;        btn.addEventListener(&quot;click&quot;, (ev) =&gt; {&#xA;            const dialog = document.createElement(&quot;dialog&quot;);&#xA;            dialog.classList.add(&quot;tableOrganizerDialog&quot;);&#xA;            document.body.appendChild(dialog);&#xA;            const localStorageKey = `${window.APPID}-${window.USERNAME}-${struct.renderId}`;&#xA;            const currentSelection = localStorage.getItem(localStorageKey) || this._dataColumns.map( column =&gt; column.components[0].id);&#xA;            dialog.innerHTML = `&#xA;                &lt;h2&gt;Select the columns you want to make visible&lt;/h2&gt;&#xA;                &lt;div class=&quot;transfer&quot;&gt;&#xA;                    &lt;select id=&quot;leftList&quot; multiple&gt;&#xA;                        ${this._dataColumns&#xA;                            .filter( column =&gt; currentSelection.indexOf(column.components[0].id) == -1 )&#xA;                            .sort( (col1, col2) =&gt; currentSelection.indexOf(col1.components[0].id) - currentSelection.indexOf(col2.components[0].id))&#xA;                            .map( column =&gt; `&lt;option value=&quot;${column.components[0].id}&quot; title=&quot;${column.components[0].properties[&quot;remarks&quot;]}&quot;&gt;${column.components[0].properties[&quot;dataattribute&quot;]} : ${column.components[0].properties[&quot;title&quot;]}&lt;/option&gt;`)}&#xA;                    &lt;/select&gt;&#xA;                    &lt;div class=&quot;transfer-buttons&quot;&gt;&#xA;                        &lt;button id=&quot;rightBtn&quot;&gt;&amp;gt;&lt;/button&gt;&#xA;                        &lt;button id=&quot;leftBtn&quot;&gt;&amp;lt;&lt;/button&gt;&#xA;                    &lt;/div&gt;&#xA;                    &lt;select id=&quot;rightList&quot; multiple &gt;&#xA;                        ${this._dataColumns&#xA;                            .filter( column =&gt; currentSelection.indexOf(column.components[0].id) &gt; -1 )&#xA;                            .sort( (col1, col2) =&gt; currentSelection.indexOf(col1.components[0].id) - currentSelection.indexOf(col2.components[0].id))&#xA;                            .map( column =&gt; `&lt;option value=&quot;${column.components[0].id}&quot; title=&quot;${column.components[0].properties[&quot;remarks&quot;]}&quot;&gt;${column.components[0].properties[&quot;dataattribute&quot;]} : ${column.components[0].properties[&quot;title&quot;]}&lt;/option&gt;`)}&#xA;                    &lt;/select&gt;&#xA;                &lt;/div&gt;&#xA;                &lt;button id=&quot;clearSelectionBtn&quot;&gt;Clear&lt;/button&gt;&#xA;                &lt;div class=&quot;footer&quot;&gt;&#xA;                    &lt;button id=&quot;ok&quot;&gt;OK&lt;/button&gt;&#xA;                    &lt;button id=&quot;cancel&quot;&gt;Cancel&lt;/button&gt;&#xA;                &lt;/div&gt;&#xA;            `;&#xA;            &#xA;            &#xA;            const leftList = dialog.querySelector(&quot;select#leftList&quot;);&#xA;            const rightList = dialog.querySelector(&quot;select#rightList&quot;);&#xA;            &#xA;            const clearSelectionBtn = dialog.querySelector(&quot;button#clearSelectionBtn&quot;);&#xA;            clearSelectionBtn.addEventListener(&quot;click&quot;, (ev) =&gt; {&#xA;                rightList.innerHTML = &quot;&quot;;&#xA;                leftList.innerHTML = &quot;&quot;;&#xA;                rightList.innerHTML = this._dataColumns.map( column =&gt; `&lt;option value=&quot;${column.components[0].id}&quot; title=&quot;${column.components[0].properties[&quot;remarks&quot;]}&quot;&gt;${column.components[0].properties[&quot;dataattribute&quot;]} : ${column.components[0].properties[&quot;title&quot;]}&lt;/option&gt;`).join(&quot;&quot;);&#xA;            });&#xA;            &#xA;            &#xA;            const move = function(from, to) {&#xA;                [...from.selectedOptions].forEach(o =&gt; to.appendChild(o));&#xA;            }&#xA;            &#xA;            leftList.addEventListener(&quot;dblclick&quot;, (ev) =&gt; {&#xA;                const option = event.target;&#xA;&#xA;                if (option.tagName === &quot;OPTION&quot;) {&#xA;                    move(leftList, rightList);&#xA;                }&#xA;            });&#xA;            &#xA;            rightList.addEventListener(&quot;dblclick&quot;, (ev) =&gt; {&#xA;                const option = event.target;&#xA;&#xA;                if (option.tagName === &quot;OPTION&quot;) {&#xA;                    move(rightList, leftList);&#xA;                }&#xA;            });&#xA;        &#xA;            dialog.querySelector(&quot;button#rightBtn&quot;).addEventListener(&quot;click&quot;, (ev) =&gt; {&#xA;                move(leftList, rightList);&#xA;            });&#xA;            dialog.querySelector(&quot;button#leftBtn&quot;).addEventListener(&quot;click&quot;, (ev) =&gt; {&#xA;                move(rightList, leftList);&#xA;            });&#xA;            dialog.querySelector(&quot;button#cancel&quot;).addEventListener(&quot;click&quot;, (ev) =&gt; {&#xA;                dialog.close();&#xA;                dialog.remove();&#xA;            });&#xA;            dialog.querySelector(&quot;button#ok&quot;).addEventListener(&quot;click&quot;, (ev) =&gt; {&#xA;                const selection = [...rightList.querySelectorAll(&quot;option&quot;)].map( option =&gt; option.value);&#xA;                localStorage.setItem(localStorageKey, selection);&#xA;                &#xA;                const tableOuter = document.getElementById(this._tableOuterId);&#xA;                //const realTableColumnHolder = tableOuter.children[0]?.children[2]?.children[0]?.children[0]?.children[0]?.children[1]?.children[0]?.children[1]?.children[0];&#xA;                            &#xA;                this.rearrangeColumns(tableOuter, selection);&#xA;                &#xA;                &#xA;                &#xA;                dialog.close();&#xA;                dialog.remove();&#xA;            });&#xA;            dialog.showModal();&#xA;    &#xA;        });&#xA;    &#xA;        const tableOuter = document.getElementById(this._tableOuterId);&#xA;        const localStorageKey = `${window.APPID}-${window.USERNAME}-${struct.renderId}`;&#xA;        const selection = localStorage.getItem(localStorageKey)?.split(&quot;,&quot;);&#xA;        if ( selection != undefined ) {&#xA;            this.rearrangeColumns(tableOuter, selection, this._dataColumns);&#xA;        }&#xA;        &#xA;        this._installObserver(tableOuter, selection);&#xA;        &#xA;        &#xA;    });&#xA;    &#xA;    debugger;&#xA;    scriptControl.registerNotificationCallBack( async (ev) =&gt; {&#xA;        this.onRefresh(ev);&#xA;    });&#xA;}&#xA;&#xA;TableOrganizer.prototype._installObserver = function(tableOuter, selection) {&#xA;    const observer = new MutationObserver((mutationsList) =&gt; {&#xA;        observer.disconnect();&#xA;        this.rearrangeColumns(tableOuter, selection, this._dataColumns);&#xA;        observer.observe(tableOuter, {&#xA;            childList: true,      // Observe direct children changes&#xA;            subtree: true,        // Observe all descendants as well&#xA;            attributes: false,     // Observe attribute changes&#xA;            characterData: false   // Observe text changes&#xA;        });&#xA;    });&#xA;    &#xA;    observer.observe(tableOuter, {&#xA;        childList: true,      // Observe direct children changes&#xA;        subtree: true,        // Observe all descendants as well&#xA;        attributes: false,     // Observe attribute changes&#xA;        characterData: false   // Observe text changes&#xA;    });&#xA;}&#xA;&#xA;TableOrganizer.prototype.rearrangeColumns = function(tableOuter, selection) {&#xA;    const realTableColumnHolder = tableOuter.querySelector(&quot;[data-control=table] table.table table.tbod tbody&quot;);&#xA;    if ( realTableColumnHolder == undefined ) {&#xA;        console.error(&quot;Unable to alter the table. Please contact the administrator&quot;);&#xA;        return;&#xA;    }&#xA;    &#xA;    &#xA;    const selectionIndex = selection.map( s =&gt; this._dataColumns.map(dc =&gt; dc.components[0].id).indexOf(s));&#xA;    debugger;&#xA;    const rows = realTableColumnHolder.querySelectorAll('tr.ttitr, tr[filter=&quot;true&quot;], tr[data-has-data=&quot;true&quot;], tr.tablerow');&#xA;    for(const row of rows) {&#xA;        for(let i = 0; i &lt; this._dataColumns.length; i++) {&#xA;            const selector = `#${CSS.escape(`${this._tableId}_ttrow_[C:${i}]-c`)}, #${CSS.escape(`${this._tableId}_tfrow_[C:${i}]-c`)}, #${CSS.escape(`${this._tableId}_tdrow_[C:${i}]-c`)}, td[headers=&quot;${CSS.escape(`${this._tableId}_ttrow_[C:${i}]-c`)}&quot;]`;&#xA;            const col = row.querySelector(selector);&#xA;            if ( col == undefined ) continue;&#xA;            if ( selectionIndex.indexOf(i) == -1 ) {&#xA;                col.style.display = &quot;none&quot;;  &#xA;            } else {&#xA;                col.style.removeProperty(&quot;display&quot;);&#xA;            }&#xA;        }&#xA;    }&#xA;}&#xA;&#xA;TableOrganizer.prototype.onRefresh = function(ev) {&#xA;    if ( ev === &quot;render&quot; || ev === &quot;refresh&quot; ) {&#xA;        let fButton = document.getElementById(this._filterButton).parentNode;&#xA;        fButton.parentNode.insertBefore(this._organizeButton,fButton);&#xA;        &#xA;        const tableOuter = document.getElementById(this._tableOuterId);&#xA;        const localStorageKey = `${window.APPID}-${window.USERNAME}-${this._tableId}`;&#xA;        const selection = localStorage.getItem(localStorageKey)?.split(&quot;,&quot;);&#xA;        this.rearrangeColumns(tableOuter, selection);&#xA;        this._installObserver(tableOuter, selection);&#xA;    }&#xA;}&#xA;&#xA;&#xA;window.TableOrganizer = TableOrganizer;" />
        <columnvalue column="ACTIVE" boolean="true" />
        <columnvalue column="HASLD" boolean="false" />
        <columnvalue column="TYPE" string="JAVASCRIPT" />
      </insertrow>
      <insertrow>
        <columnvalue column="DESCRIPTION" string="Organize asset results table" />
        <columnvalue column="SCRIPTNUM" string="ASSET_ORGANIZE_RS" />
        <columnvalue column="SCRIPTCONTENT" string="new TableOrganizer(&quot;results_showlist&quot;, this);" />
        <columnvalue column="ACTIVE" boolean="true" />
        <columnvalue column="HASLD" boolean="false" />
        <columnvalue column="TYPE" string="JAVASCRIPT" />
      </insertrow>
      <insertrow>
        <columnvalue column="DESCRIPTION" string="Status flow CSS" />
        <columnvalue column="SCRIPTNUM" string="STATUS_FLOW_CSS" />
        <columnvalue column="SCRIPTCONTENT" string=".statusFlow {&#xA;    padding: 10px;&#xA;    display: flex;&#xA;    flex-direction: row;&#xA;    gap: 40px;&#xA;    background: white;&#xA;    justify-content: center;&#xA;&#xA;    &amp; span#nodata {&#xA;        font-style: italic;&#xA;        color: gray;&#xA;    }&#xA;    &#xA;    &amp; .statusFlowMilestone {&#xA;        border: 1px solid lightgray;&#xA;        border-radius: 5px;&#xA;        padding: 5px;&#xA;        position: relative;&#xA;        box-shadow: 3px 3px 10px 2px rgba(0, 0, 0, 0.51);&#xA;    &#xA;        &amp; .desc {&#xA;            color: #0c417a;&#xA;            font-size: 24pt;&#xA;        }&#xA;        &#xA;        &amp; .memo {&#xA;            color: red;&#xA;        }&#xA;        &#xA;        &amp; .changeBy {&#xA;            color: blue;&#xA;        }&#xA;        &#xA;        &amp; .changeDate {&#xA;            &#xA;            color: #838383;&#xA;            font-style: italic;&#xA;            font-size: small;&#xA;        }&#xA;        &#xA;        &amp;:not(:first-of-type)::before {&#xA;            content: '';&#xA;            width: 40px;&#xA;            height: 2px;&#xA;            background: #0c417a;;&#xA;            position: absolute;&#xA;            display: block;&#xA;            top: 49%;&#xA;            left: -41px;&#xA;        }&#xA;    }&#xA;}" />
        <columnvalue column="ACTIVE" boolean="true" />
        <columnvalue column="HASLD" boolean="false" />
        <columnvalue column="TYPE" string="CSS" />
      </insertrow>
      <insertrow>
        <columnvalue column="DESCRIPTION" string="Status flow" />
        <columnvalue column="SCRIPTNUM" string="STATUS_FLOW" />
        <columnvalue column="SCRIPTCONTENT" string="//debugger;&#xA;&#xA;const pageMapping = await this.getComponentsMapping();&#xA;let sectionId = pageMapping[&quot;status_flow_container&quot;];&#xA;if ( sectionId === undefined ) {&#xA;    console.error(&quot;Unable to find target section&quot;);&#xA;    return;&#xA;}&#xA;&#xA;&#xA;sectionId = sectionId[&quot;status_flow_container-se&quot;].renderId;  // this is where the canvas will be injected&#xA;const section = document.getElementById(sectionId);&#xA;&#xA;const computeTemplate = async () =&gt; {&#xA;    const statuses = await this.getData(&quot;asset_status_ds&quot;, [&quot;status&quot;, &quot;status.description&quot;, &quot;changeby&quot;, &quot;changedate&quot;, &quot;memo&quot;]);&#xA;    if ( statuses.status !== &quot;ok&quot; ) {&#xA;        console.error(&quot;Data request failed. Please check logs.&quot;);&#xA;        return;&#xA;    }&#xA;    if ( statuses.data.length == 0 ) {&#xA;        return `&lt;div class=&quot;statusFlow&quot;&gt;&#xA;            &lt;span id=&quot;nodata&quot;&gt;Aucun changement de statut pour cet équipement&lt;/span&gt;&#xA;        &lt;/div&gt;`;&#xA;    }&#xA;    &#xA;    return `&lt;div class=&quot;statusFlow&quot;&gt;&#xA;        ${statuses.data.map( s =&gt; `&#xA;            &lt;div class=&quot;statusFlowMilestone&quot; title=&quot;${s[&quot;memo&quot;]}&quot;&gt;&#xA;                &lt;div class=&quot;desc&quot;&gt;${s[&quot;status.description&quot;]}&lt;/div&gt;&#xA;                &lt;div class=&quot;changeBy&quot;&gt;${s[&quot;changeby&quot;]}&lt;/div&gt;&#xA;                &lt;div class=&quot;changeDate&quot;&gt;${new Date(s[&quot;changedate&quot;]).toLocaleString()}&lt;/div&gt;&#xA;            &lt;/div&gt;&#xA;        `).join(&quot;&quot;)}&#xA;    &lt;/div&gt;`;&#xA;};&#xA;&#xA;let tpl = await computeTemplate();&#xA;section.innerHTML = tpl;&#xA;&#xA;this.registerNotificationCallBack( async (ev) =&gt; {&#xA;    const section = document.getElementById(sectionId);&#xA;    if ( ev === &quot;update&quot; || ev === &quot;refresh&quot; ) {&#xA;           tpl = await computeTemplate();&#xA;    }&#xA;    section.innerHTML = tpl;    &#xA;});" />
        <columnvalue column="ACTIVE" boolean="true" />
        <columnvalue column="HASLD" boolean="false" />
        <columnvalue column="TYPE" string="JAVASCRIPT" />
      </insertrow>
    </insert>
    
  </statements>
</script>
