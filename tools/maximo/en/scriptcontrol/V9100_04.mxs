<?xml version="1.0" encoding="UTF-8"?>
<updatescript version="7.1.0.0">
	<app apptype="webclient" id="designer">
		<add before="mxdproperties_appbar" container="designer" control="dialog">
			<set property="beanclass" value="psdi.webclient.beans.designer.ControlPropertiesBean"/>
			<set property="closeevent" value="PROPERTIES"/>
			<set property="id" value="mxdproperties_script"/>
			<set property="label" value="Script Properties"/>
			<set property="mboname" value="CTRL_SCRIPTCONTROL"/>
			<set property="modal" value="false"/>
			<set property="properties" value="true"/>
			<set property="saveposition" value="true"/>
			<set property="showclose" value="true"/>
		</add>
		<add container="mxdproperties_script" control="section">
			<set property="id" value="prop_script_1"/>
		</add>
		<add container="prop_script_1" control="textbox">
			<set property="dataattribute" value="id"/>
			<set property="id" value="prop_script_id"/>
		</add>
		<add container="prop_script_1" control="textbox">
			<set property="dataattribute" value="scriptnum"/>
			<set property="id" value="prop_script_method"/>
		</add>
		<add container="prop_script_1" control="textbox">
			<set property="dataattribute" value="datasrc"/>
			<set property="id" value="prop_script_datasrc"/>
		</add>
	</app>
</updatescript>
